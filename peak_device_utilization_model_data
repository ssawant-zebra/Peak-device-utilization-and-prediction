create or replace TEMP table `peak_data` as ( 
select *,
ROW_NUMBER() OVER(PARTITION BY sitename ORDER BY yyyy_mm) AS period,
trim(SUBSTR(`yyyy_mm`, 6, 2)) AS month
 from
`dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.peak_device_utilization_anlytc_model_seasdata` 
);

create or replace TEMP table `peak_avg_data` as ( 
select *,avg(avg_month) OVER(PARTITION BY sitename) AS avg_of_avg from(
select sitename,month,avg(ifnull(utilized_devices_model,0))  AS avg_month
from peak_data
group by sitename,month));

create or replace TEMP table `datasn1` as (
  select a.*,b.avg_month,b.avg_of_avg
  from peak_data  as a left join peak_avg_data as b
  on a.sitename = b.sitename and a.month=b.month
 );

create or replace TEMP table `datasn2` as (
  select *,round(safe_divide(ifnull(utilized_devices_model,0),seas_index),3) as deseas from(
  select *, round(safe_divide(avg_month,avg_of_avg),3) as seas_index
  from datasn1)
 );

create or replace TEMP table `trend_reg` as (
SELECT Bucket,
       SLOPE,
       (SUM_OF_Y - SLOPE * SUM_OF_X) / N AS INTERCEPT,
       CORRELATION
FROM (
    SELECT Bucket,
           N,
           SUM_OF_X,
           SUM_OF_Y,
           CORRELATION * STDDEV_OF_Y / STDDEV_OF_X AS SLOPE,
           CORRELATION
    FROM (
        SELECT Bucket,
               COUNT(*) AS N,
               SUM(X) AS SUM_OF_X,
               SUM(Y) AS SUM_OF_Y,
               STDDEV_POP(X) AS STDDEV_OF_X,
               STDDEV_POP(Y) AS STDDEV_OF_Y,
               CORR(X,Y) AS CORRELATION
        FROM (SELECT sitename AS Bucket,
                     period AS X,
                     deseas AS Y
              FROM datasn2)
        WHERE Bucket IS NOT NULL AND
              X IS NOT NULL AND
              Y IS NOT NULL
        GROUP BY Bucket)));
    
create or replace TEMP table `datasn3` as (
  select a.*,b.intercept,b.slope
  from datasn2  as a left join trend_reg as b
  on a.sitename = b.Bucket 
 );

 create or replace TEMP table `fits` as (
  select *,round(trend_line_est*seas_index,3) as pred from(
  select *,round((intercept+slope*period),3) as trend_line_est
    from datasn3)order by sitename,yyyy_mm
 );

