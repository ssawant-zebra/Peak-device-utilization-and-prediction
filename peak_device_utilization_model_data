create or replace TEMP table `model_eval_0` as (
  select *,ifnull(round(abs_error/rmse,2),0) as err_in_terms_of_stddev,
  ((1.96*rmse)) as stdev from(
select *,sqrt(mse) as rmse,avg(pct_abs_error) over (partition by sitename) as mape from(
select *,ifnull(abs_error/nullif(utilized_devices_model,0),0) as pct_abs_error,
avg(squared_error) over (partition by sitename) as mse,
avg(abs_error) over (partition by sitename) as mad from(
select *, (residuals*residuals) as squared_error,abs(residuals) as abs_error,
avg(residuals) over (partition by sitename) as bias,
stddev(residuals) over (partition by sitename) as sigma,
count(sitename) over (partition by sitename) as cnt from(
select sitename,yyyy_mm,period, utilized_devices_model,pred,
round(utilized_devices_model-pred,2) as residuals
from fits ))))
order by sitename,period ) ;

create or replace TEMP table `rmse_0` as (
select distinct sitename,bias,mse, mad,mape,rmse from model_eval_0);

