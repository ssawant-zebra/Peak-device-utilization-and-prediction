create or replace TEMP table `future_table_0` as (
select *,CONCAT("2024","-",month) AS yyyy_mm,round(trend_line_fcst*seas_index,0) as predicted_utilized from(
select *,max_hist_period+pre_period as period,(intercept+slope*(max_hist_period+pre_period)) as trend_line_fcst from(
select *, ROW_NUMBER() OVER(PARTITION BY sitename order by cast(month as INT64)) AS pre_period from(
select distinct sitename,month,max_hist_period,intercept,slope,seas_index,last_month from(
select sitename,month,max(period) OVER(PARTITION BY sitename) AS max_hist_period,
cast(last_value(month) over (partition by sitename order by sitename) as INT64) as last_month,intercept,slope,seas_index
from fits)
where cast(month as INT64) > last_month order by cast(month as INT64))))order by sitename,period)  ;

create or replace TEMP table `pred_interval` as (
select a.*,b.rmse 
from future_table_0 as a left join rmse_0 as b
on a.sitename=b.sitename
order by sitename,period)  ;


create or replace TEMP table `future_table_1` as (
select sitename,yyyy_mm,slope,intercept,seas_index,trend_line_fcst,predicted_utilized,rmse,
round(predicted_utilized-rmse) as predicted_utilized_devices_lower_limt,
round(predicted_utilized+rmse) as predicted_utilized_devices_upper_limt,
predicted_utilized - (LAG(predicted_utilized)  over (partition by sitename order by yyyy_mm) ) as extra_devices
from pred_interval
order by sitename,yyyy_mm);

create or replace TEMP table `future_table_1_vars` as (
select sitename,yyyy_mm,predicted_utilized as predicted_future_utilized_devices_model,
predicted_utilized_devices_lower_limt as Lower_prediction_Limit,
predicted_utilized_devices_upper_limt as Upper_prediction_Limit,
extra_devices as estimated_additional_devices,
rmse as stdev from future_table_1
);

create or replace TEMP table `future_table_nonseas` as (
select sitename,
concat(trim(substr(format_timestamp('%Y%m', prediction_date) ,1,4)),"-",trim(substr(format_timestamp('%Y%m', prediction_date) ,5,2))) as yyyy_mm,
round(predicted_future_utilized_devices_model,0) as predicted_future_utilized_devices_model,
CAST(Lower_prediction_Limit as float64) as Lower_prediction_Limit ,	
CAST(Upper_prediction_Limit as float64) as Upper_prediction_Limit,	estimated_additional_devices,	stdev
from  `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.model_results_nonseasonal` );

create or replace TEMP table `comb_future_table` as (
select * from future_table_1_vars
union all
select * from future_table_nonseas
order by sitename,yyyy_mm);


