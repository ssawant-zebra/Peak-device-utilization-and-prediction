-- select sites with no peak devies shipped
create or replace TEMP table `sitewise_no_peak_data` as (
select distinct sitename,season_period from(
select sitename, sum(total_num_peak_devices_matched) AS season_period from(
SELECT sitename,cast(substr(yyyy_mm,1,4) as int64) as year,total_num_peak_devices_matched   
FROM `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.monthly_device_utilization_anlytc` 
where yyyy_mm in ('2022-11','2022-12','2023-11','2023-12'))group by sitename)
where season_period is NULL);

-- sites with peak devices shipped only in 2022
-- combines these sites with no peak data
create or replace TEMP table `sites_with_no_seasonal_data_2022` as (
select sitename,1 as season_period from(
select *,COUNT(year) OVER(PARTITION BY sitename) AS season_year from (
select distinct sitename, year from (
select *,cast(substr(yyyy_mm,1,4) as int64) as year,
COUNT(sitename) OVER(PARTITION BY sitename) AS season_period from(
SELECT * FROM `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.monthly_device_utilization_anlytc` 
where yyyy_mm in ('2022-11','2022-12','2023-11','2023-12') and num_peak_devices_utilized>0))))
where season_year = 1 and year = 2022);

create or replace TEMP table `sites_with_no_peak_data` as (
  select * from sitewise_no_peak_data
  union all
  select * from sites_with_no_seasonal_data_2022
);


create or replace  table `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.peak_device_utilization_anlytc_model_nopeakdata` as ( 
select a.*
from `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.monthly_device_utilization_anlytc`  as a 
inner join sitewise_no_peak_data  as b 
on a.sitename = b.sitename 
order by sitename,yyyy_mm);

